#!/usr/bin/env bash
set -euo pipefail

ACME_HOME=/root/.acme.sh
DOMAIN={{ node_fqdn | quote }}
SELFSTEAL_DIR={{ selfsteal_dir | quote }}
INSTALLED_CERT={{ (selfsteal_dir + '/ssl/fullchain.crt') | quote }}
INSTALLED_KEY={{ (selfsteal_dir + '/ssl/private.key') | quote }}
STAGE_DIR=/run/selfsteal-cert-renew
RENEW_BEFORE_SECONDS=$((30 * 24 * 60 * 60))
ACME_TIMEOUT_SECONDS=300
REMNANODE_WAS_RUNNING=false
SELFSTEAL_NEEDS_START=false

certificate_key_fingerprint() {
  openssl x509 -in "$1" -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | sha256sum | cut -d' ' -f1
}

install_certificate_pair() {
  install -o root -g root -m 0600 "$INSTALLED_KEY" "$STAGE_DIR/previous.key"
  install -o root -g root -m 0644 "$INSTALLED_CERT" "$STAGE_DIR/previous.crt"
  (
    restore_previous_pair() {
      install -o root -g root -m 0600 "$STAGE_DIR/previous.key" "$INSTALLED_KEY" || true
      install -o root -g root -m 0644 "$STAGE_DIR/previous.crt" "$INSTALLED_CERT" || true
    }
    trap 'rc=$?; if [ "$rc" -ne 0 ]; then restore_previous_pair; fi; exit "$rc"' EXIT
    install -o root -g root -m 0600 "$STAGE_DIR/private.key" "$INSTALLED_KEY"
    install -o root -g root -m 0644 "$STAGE_DIR/fullchain.crt" "$INSTALLED_CERT"
    test "$(certificate_key_fingerprint "$INSTALLED_CERT")" = \
      "$(openssl pkey -in "$INSTALLED_KEY" -pubout -outform DER 2>/dev/null \
        | sha256sum | cut -d' ' -f1)"
    trap - EXIT
  )
}

cleanup() {
  rm -rf "$STAGE_DIR"
  if [ "$SELFSTEAL_NEEDS_START" = true ]; then
    docker compose --project-directory "$SELFSTEAL_DIR" up -d --remove-orphans >/dev/null 2>&1 || true
  fi
  while iptables -t nat -C PREROUTING -p tcp --dport 443 -j REDIRECT --to-port 8443 2>/dev/null; do
    iptables -t nat -D PREROUTING -p tcp --dport 443 -j REDIRECT --to-port 8443 || true
  done
  while iptables -t nat -C OUTPUT -p tcp --dport 443 -o lo -j REDIRECT --to-port 8443 2>/dev/null; do
    iptables -t nat -D OUTPUT -p tcp --dport 443 -o lo -j REDIRECT --to-port 8443 || true
  done
  if [ "$REMNANODE_WAS_RUNNING" = true ]; then
    docker start remnanode >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT INT TERM

installed_fingerprint="$(certificate_key_fingerprint "$INSTALLED_CERT")"
ecc_dir="$ACME_HOME/${DOMAIN}_ecc"
rsa_dir="$ACME_HOME/$DOMAIN"
ecc_flag=()
issue_keylength=2048

if [ -f "$ecc_dir/fullchain.cer" ] \
  && [ "$(certificate_key_fingerprint "$ecc_dir/fullchain.cer")" = "$installed_fingerprint" ]; then
  domain_conf="$ecc_dir/$DOMAIN.conf"
  ecc_flag=(--ecc)
  issue_keylength=ec-256
elif [ -f "$rsa_dir/fullchain.cer" ] \
  && [ "$(certificate_key_fingerprint "$rsa_dir/fullchain.cer")" = "$installed_fingerprint" ]; then
  domain_conf="$rsa_dir/$DOMAIN.conf"
else
  echo "Cannot match the installed SelfSteal certificate to an acme.sh domain" >&2
  exit 1
fi

if [ ! -r "$domain_conf" ] \
  || ! grep -Fx "Le_Domain='$DOMAIN'" "$domain_conf" >/dev/null \
  || ! grep -Eq "^Le_Webroot='?(/|alpn|tls_alpn)" "$domain_conf"; then
  echo "The active acme.sh domain configuration is missing or unsupported" >&2
  exit 1
fi

if [ "${1:-}" = '--check' ]; then
  exit 0
fi

if openssl x509 -in "$INSTALLED_CERT" -noout -checkend "$RENEW_BEFORE_SECONDS" >/dev/null 2>&1; then
  exit 0
fi

if grep -Eq "^Le_Webroot='?(alpn|tls_alpn)'?$" "$domain_conf"; then
  if [ "$(docker inspect --format '{% raw %}{{.State.Running}}{% endraw %}' remnanode 2>/dev/null || true)" = true ]; then
    REMNANODE_WAS_RUNNING=true
    docker stop remnanode >/dev/null
  fi

  while iptables -t nat -C PREROUTING -p tcp --dport 443 -j REDIRECT --to-port 8443 2>/dev/null; do
    iptables -t nat -D PREROUTING -p tcp --dport 443 -j REDIRECT --to-port 8443
  done
  while iptables -t nat -C OUTPUT -p tcp --dport 443 -o lo -j REDIRECT --to-port 8443 2>/dev/null; do
    iptables -t nat -D OUTPUT -p tcp --dport 443 -o lo -j REDIRECT --to-port 8443
  done

  timeout --signal=TERM --kill-after=10s "$ACME_TIMEOUT_SECONDS" \
    "$ACME_HOME/acme.sh" --issue --domain "$DOMAIN" --keylength "$issue_keylength" \
    --alpn --tlsport 443 --server letsencrypt --force
else
  timeout --signal=TERM --kill-after=10s "$ACME_TIMEOUT_SECONDS" \
    "$ACME_HOME/acme.sh" --issue --domain "$DOMAIN" --keylength "$issue_keylength" \
    --webroot {{ (selfsteal_dir + '/html') | quote }} --server letsencrypt --force
fi

rm -rf "$STAGE_DIR"
install -d -m 0700 "$STAGE_DIR"

"$ACME_HOME/acme.sh" --install-cert --domain "$DOMAIN" "${ecc_flag[@]}" \
  --key-file "$STAGE_DIR/private.key" \
  --fullchain-file "$STAGE_DIR/fullchain.crt" \
  --reloadcmd /bin/true

openssl x509 -in "$STAGE_DIR/fullchain.crt" -noout \
  -checkhost "$DOMAIN" -checkend 86400 >/dev/null
test "$(certificate_key_fingerprint "$STAGE_DIR/fullchain.crt")" = \
  "$(openssl pkey -in "$STAGE_DIR/private.key" -pubout -outform DER 2>/dev/null \
    | sha256sum | cut -d' ' -f1)"
test "$(openssl x509 -in "$STAGE_DIR/fullchain.crt" -noout -subject -nameopt RFC2253 | sed 's/^subject=//')" != \
  "$(openssl x509 -in "$STAGE_DIR/fullchain.crt" -noout -issuer -nameopt RFC2253 | sed 's/^issuer=//')"

docker compose --project-directory "$SELFSTEAL_DIR" down --remove-orphans
SELFSTEAL_NEEDS_START=true
rm -f /dev/shm/nginx.sock
install_certificate_pair
docker compose --project-directory "$SELFSTEAL_DIR" up -d --remove-orphans
SELFSTEAL_NEEDS_START=false

stable_checks=0
for attempt in $(seq 1 30); do
  state="$(docker inspect --format \
    '{% raw %}status={{.State.Status}} running={{.State.Running}} restarting={{.State.Restarting}}{% endraw %}' \
    nginx-selfsteal 2>&1 || true)"
  if [[ "$state" == *'status=running running=true restarting=false'* ]]; then
    stable_checks=$((stable_checks + 1))
    if [ "$stable_checks" -ge 3 ]; then
      docker exec nginx-selfsteal nginx -t
      rm -rf "$STAGE_DIR"
      exit 0
    fi
  else
    stable_checks=0
  fi
  sleep 2
done

echo "SelfSteal did not recover after certificate renewal: $state" >&2
docker logs --tail 100 nginx-selfsteal >&2 || true
exit 1
