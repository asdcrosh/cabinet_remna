# Copy this file to .env.provisioner on the server and set mode 0600.
# It is intentionally separate from the web application's environment.

NODE_ENV="production"
DATABASE_URL="postgresql://cabinet:ВСТАВЬ_СЮДА_ПАРОЛЬ_БД@db:5432/cabinet?schema=public&connection_limit=5&pool_timeout=20"

# Generate independently from JWT_SECRET: openssl rand -hex 32
NODE_PROVISIONING_ENCRYPTION_KEY="ВСТАВЬ_СЮДА_ОТДЕЛЬНЫЙ_СЕКРЕТ_32_PLUS"

# Least-privilege provider credentials used only by the provisioning worker.
TIMEWEB_API_TOKEN="ВСТАВЬ_СЮДА_TIMEWEB_API_TOKEN"
REMNAWAVE_BASE_URL="https://ВСТАВЬ_СЮДА_ДОМЕН_REMNAWAVE"
REMNAWAVE_TOKEN="ВСТАВЬ_СЮДА_REMNAWAVE_API_TOKEN"
NODE_PROVISIONING_BASE_DOMAIN="ВСТАВЬ_СЮДА_ОСНОВНОЙ_ДОМЕН"
NODE_PROVISIONING_TCP_TEMPLATE_HOST_UUID="ВСТАВЬ_СЮДА_UUID_TCP_HOST"
NODE_PROVISIONING_XHTTP_TEMPLATE_HOST_UUID="ВСТАВЬ_СЮДА_UUID_XHTTP_HOST"
NODE_PROVISIONING_COUNTRY_CODE="XX"

# Public panel address allowed to reach the Remnanode API on port 2222.
# The current SSH port stays publicly reachable, matching the manual runbook.
NODE_PROVISIONING_PANEL_IP="ВСТАВЬ_СЮДА_IP_ПАНЕЛИ"
NODE_PROVISIONING_ADMIN_EMAIL="ВСТАВЬ_СЮДА_EMAIL_АДМИНА"
NODE_PROVISIONING_REMNANODE_IMAGE="remnawave/node:ВСТАВЬ_СЮДА_ПРОВЕРЕННУЮ_ВЕРСИЮ"

NODE_PROVISIONING_WORKER_INTERVAL_SECONDS="5"
NODE_PROVISIONING_WORKER_HEARTBEAT_MAX_AGE_SECONDS="180"
NODE_PROVISIONING_CREDENTIALS_TTL_HOURS="24"
NODE_PROVISIONING_DNS_TIMEOUT_SECONDS="300"
NODE_PROVISIONING_CONNECT_TIMEOUT_SECONDS="300"
NODE_PROVISIONING_ANSIBLE_PLAYBOOK="/app/deploy/provisioner/provision-remnanode.yml"
NODE_PROVISIONING_ANSIBLE_TIMEOUT_SECONDS="1800"
